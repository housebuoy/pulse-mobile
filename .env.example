# Pulse mobile — environment variables (copy to .env for local runs)
# Expo reads EXPO_PUBLIC_* vars at build/start time. No .env = defaults apply.

# API base URL. Defaults to http://localhost:8080/api (see src/lib/api/client.ts).
# Android emulator: use http://10.0.2.2:8080/api (emulator's alias for host localhost).
# Physical device: use your machine's LAN IP, e.g. http://192.168.1.50:8080/api.
# Live backend (Render): https://pulse-o3gj.onrender.com/api
EXPO_PUBLIC_API_URL=http://localhost:8080/api

# Mock-data swap (same pattern as pulse-web lib/mock). The app runs on store
# seeds UNLESS this is explicitly "false" — set it to hit the real API:
# EXPO_PUBLIC_USE_MOCK=false
